DATABASE_URL="file:./dev.db"

# Auth configuration
# If empty, uses local users table. If set, uses Keycloak.
JWKS_URL=http://localhost:8080/realms/master/protocol/openid-connect/certs

# Local JWT secret (only used when not using Keycloak)
JWT_SECRET="change-me-in-production-use-openssl-rand-hex-32"

# Keycloak configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=ticket-system
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=http://localhost:5173/login/callback
KEYCLOAK_ISSUER=http://localhost:8080/realms/master

# Logging level: debug, warn, error
LOG_LEVEL=debug

# Server port
PORT=3000
