generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id                 String         @id @default(uuid())
  title              String
  description        String?
  status             TicketStatus   @default(OPEN)
  priority           TicketPriority @default(MEDIUM)
  reporterUser       String?
  reporterEmail      String?
  reporterOrg        String?
  assignedAgentId    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([status])
  @@index([priority])
  @@index([createdAt])
}
